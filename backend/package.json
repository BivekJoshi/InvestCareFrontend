{
  "name": "investcare-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CMS backend for Invest Care Limited — authentication API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
