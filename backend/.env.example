# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma separated list of origins allowed to call this API (the CMS / website)
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
# Either set DATABASE_URL, or the discrete PG* values below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investcare_cms
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=investcare_cms
# Set to true when connecting to a managed database that requires SSL
DB_SSL=false

# ---- Auth ----
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# ---- Seed admin (used by `npm run db:seed`) ----
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=P@ssw0rd
